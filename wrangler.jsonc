{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // the book page (title + inlined data), API and photos hit the Worker first; the rest comes straight from the edge
    "run_worker_first": ["/", "/api/*", "/img/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "techo-db", "database_id": "09d467c6-98de-46e4-8eb3-db07c06c6f45" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "techo-photos" }
  ],
  "vars": {
    // admin login: a GitHub OAuth App whose callback is <site>/api/auth/github/callback (see README);
    // its client secret goes in with `npx wrangler secret put GITHUB_CLIENT_SECRET`
    "GITHUB_CLIENT_ID": "",
    "ADMIN_GITHUB_LOGIN": "cuijianzhuang",
    // the journal's days follow this zone (nightly draft, "today")
    "TIMEZONE": "Asia/Shanghai"
  },
  // 23:30 Asia/Shanghai: write today's draft from the jots if the desktop task (22:00) didn't
  "triggers": { "crons": ["30 15 * * *"] },
  "observability": { "enabled": true }
}
