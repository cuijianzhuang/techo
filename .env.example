# techo on a VPS (docker compose, or `npm start`): copy to .env and fill in. Cloudflare doesn't read this file:
# there these are in wrangler.jsonc (vars) and `wrangler secret put` (secrets).

# your domain, pointed (A / AAAA record) at the VPS; Caddy gets its HTTPS certificate
DOMAIN=journal.example.com

# admin login: a GitHub OAuth App whose callback is https://<DOMAIN>/api/auth/github/callback (docs/deploy.md §3)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGIN=your-github-name

# the journal's days follow this zone (the nightly draft, "today")
TIMEZONE=Asia/Shanghai

# optional ------------------------------------------------------------------------------------------------
# the AI's key (it can be pasted in the admin instead: 手帐设置 → 接入服务 → AI)
# AI_API_KEY=
# a Meting API's token, when 手帐设置 has none
# METING_TOKEN=
# another NeoDB instance than neodb.social
# NEODB_URL=
# when the nightly draft is written: "minute hour * * *" in UTC (15:30 UTC = 23:30 in Shanghai)
# NIGHTLY_CRON=30 15 * * *
# where the server listens, and where it keeps its data (the Docker image: 8787 and /data)
# PORT=8787
# DATA_DIR=./data
# 1 (default): behind Caddy / nginx, trust their X-Forwarded-* headers; 0 when the server faces the internet itself
# TRUST_PROXY=1
